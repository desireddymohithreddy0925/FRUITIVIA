<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="14-01" author="antigravity">
        <createTable tableName="orders">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="buyer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quotation_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="buyer_id"
                                 constraintName="fk_orders_buyer"
                                 referencedTableName="buyers" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="quotation_id"
                                 constraintName="fk_orders_quotation"
                                 referencedTableName="quotations" referencedColumnNames="id"/>

        <createTable tableName="order_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="fruit_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="variety_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="line_total" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="order_items" baseColumnNames="order_id"
                                 constraintName="fk_order_items_order"
                                 referencedTableName="orders" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="order_items" baseColumnNames="fruit_id"
                                 constraintName="fk_order_items_fruit"
                                 referencedTableName="fruits" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="order_items" baseColumnNames="variety_id"
                                 constraintName="fk_order_items_variety"
                                 referencedTableName="fruit_varieties" referencedColumnNames="id"/>

        <createTable tableName="order_item_allocations">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_item_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="fruit_batch_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="order_item_allocations" baseColumnNames="order_item_id"
                                 constraintName="fk_order_item_allocations_item"
                                 referencedTableName="order_items" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="order_item_allocations" baseColumnNames="fruit_batch_id"
                                 constraintName="fk_order_item_allocations_batch"
                                 referencedTableName="fruit_batches" referencedColumnNames="id"/>

        <createTable tableName="order_status_history">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_id" type="UUID"/>
            <column name="notes" type="VARCHAR(1000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="order_status_history" baseColumnNames="order_id"
                                 constraintName="fk_order_history_order"
                                 referencedTableName="orders" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="order_status_history" baseColumnNames="actor_id"
                                 constraintName="fk_order_history_actor"
                                 referencedTableName="users" referencedColumnNames="id"/>

        <createTable tableName="order_sequences">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="prefix_year" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="next_value" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
