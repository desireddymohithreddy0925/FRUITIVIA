<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="2" author="fruitivia">
        <addForeignKeyConstraint baseTableName="buyers" baseColumnNames="user_id"
                                 constraintName="fk_buyers_user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="SET NULL"/>
                                 
        <addForeignKeyConstraint baseTableName="fruit_varieties" baseColumnNames="fruit_id"
                                 constraintName="fk_fruit_varieties_fruit_id"
                                 referencedTableName="fruits"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
