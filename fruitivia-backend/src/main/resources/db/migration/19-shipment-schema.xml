<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="19-shipment-schema" author="system">
        <createTable tableName="shipments">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_shipment_order" referencedTableName="orders" referencedColumnNames="id"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="container_number" type="varchar(255)"/>
            <column name="shipping_company" type="varchar(255)"/>
            <column name="tracking_number" type="varchar(255)"/>
            <column name="origin_port" type="varchar(255)"/>
            <column name="destination_port" type="varchar(255)"/>
            <column name="destination_country" type="varchar(2)"/>
            <column name="shipment_date" type="timestamp with time zone"/>
            <column name="expected_delivery" type="timestamp with time zone"/>
            <column name="actual_delivery" type="timestamp with time zone"/>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="shipment_items">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shipment_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_shipment_item_shipment" referencedTableName="shipments" referencedColumnNames="id"/>
            </column>
            <column name="packaging_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_shipment_item_packaging" referencedTableName="packaging_records" referencedColumnNames="id"/>
            </column>
            <column name="batch_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_shipment_item_batch" referencedTableName="fruit_batches" referencedColumnNames="id"/>
            </column>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="shipment_status_history">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shipment_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_shipment_status_history_shipment" referencedTableName="shipments" referencedColumnNames="id"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="varchar(1000)"/>
            <column name="actor" type="varchar(255)"/>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
