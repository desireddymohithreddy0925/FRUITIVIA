<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="10-inventory-schema-01" author="fruitivia">

        <createTable tableName="inventories">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false" unique="true" foreignKeyName="fk_inventory_batch" references="fruit_batches(id)"/>
            </column>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_inventory_warehouse" references="warehouses(id)"/>
            </column>
            <column name="storage_location_id" type="UUID">
                <constraints foreignKeyName="fk_inventory_storage_location" references="storage_locations(id)"/>
            </column>
            <column name="total_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="available_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="packed_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="dispatched_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="damaged_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="expired_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="inventory_transactions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="inventory_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_inv_trans_inventory" references="inventories(id)"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="before_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="after_quantity" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="reference" type="VARCHAR(255)"/>
            <column name="actor" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
