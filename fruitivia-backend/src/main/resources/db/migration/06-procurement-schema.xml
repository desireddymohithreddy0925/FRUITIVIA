<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="06-procurement-schema-01" author="fruitivia">
        <createTable tableName="procurement_orders">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="supplier_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_procurement_supplier" references="suppliers(id)"/>
            </column>
            <column name="purchase_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="harvest_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_procurement_warehouse" references="warehouses(id)"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="procurement_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="procurement_order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pi_procurement_order" references="procurement_orders(id)"/>
            </column>
            <column name="fruit_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pi_fruit" references="fruits(id)"/>
            </column>
            <column name="variety_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pi_variety" references="fruit_varieties(id)"/>
            </column>
            <column name="quantity" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="procurement_state_history">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="procurement_order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_psh_procurement_order" references="procurement_orders(id)"/>
            </column>
            <column name="previous_status" type="VARCHAR(50)"/>
            <column name="new_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
