<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="08-fruit-batch-schema-01" author="fruitivia">
        <createTable tableName="batch_sequences">
            <column name="prefix_year" type="VARCHAR(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="next_value" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="fruit_batches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="procurement_item_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_procurement_item" references="procurement_items(id)"/>
            </column>
            <column name="supplier_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_supplier" references="suppliers(id)"/>
            </column>
            <column name="fruit_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_fruit" references="fruits(id)"/>
            </column>
            <column name="variety_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_variety" references="fruit_varieties(id)"/>
            </column>
            <column name="quality_inspection_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_inspection" references="quality_inspections(id)"/>
            </column>
            <column name="quality_grade" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_quantity" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="warehouse_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fb_warehouse" references="warehouses(id)"/>
            </column>
            <column name="harvest_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="packing_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="shelf_life_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="fruit_batch_history">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fruit_batch_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_fbh_batch" references="fruit_batches(id)"/>
            </column>
            <column name="previous_status" type="VARCHAR(50)"/>
            <column name="new_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
