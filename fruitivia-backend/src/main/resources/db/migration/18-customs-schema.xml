<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="18-customs-schema" author="system">
        <createTable tableName="customs_declarations">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reference" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="export_country" type="varchar(2)">
                <constraints nullable="false"/>
            </column>
            <column name="destination_country" type="varchar(2)">
                <constraints nullable="false"/>
            </column>
            <column name="export_port" type="varchar(255)"/>
            <column name="destination_port" type="varchar(255)"/>
            <column name="customs_broker" type="varchar(255)"/>
            <column name="duties_and_taxes" type="numeric(15,2)"/>
            <column name="declaration_date" type="timestamp with time zone"/>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="customs_clearances">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_customs_clearance_order" referencedTableName="orders" referencedColumnNames="id"/>
            </column>
            <column name="declaration_id" type="uuid">
                <constraints foreignKeyName="fk_customs_clearance_declaration" referencedTableName="customs_declarations" referencedColumnNames="id"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="inspection_status" type="varchar(50)"/>
            <column name="remarks" type="varchar(2000)"/>
            <column name="clearance_date" type="timestamp with time zone"/>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="customs_status_history">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="clearance_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_customs_status_history_clearance" referencedTableName="customs_clearances" referencedColumnNames="id"/>
            </column>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="varchar(1000)"/>
            <column name="actor" type="varchar(255)"/>
            
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
